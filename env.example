# UniFi AI Network Management environment template.
# Copy to /home/<user>/.openclaw/unifi.env or run ./setup.sh.
# Keep real keys out of git and chat.

# Official Site Manager cloud API
# Create/revoke from UniFi Site Manager / developer workflow.
UNIFI_SITE_MANAGER_API_KEY=
UNIFI_SITE_MANAGER_BASE_URL=https://api.ui.com/v1

# Official local UniFi Network Integration API on a UDM Pro / Cloud Gateway / Network app
# Create/revoke from UniFi Network > Settings > Control Plane > Integrations.
UNIFI_NETWORK_BASE_URL=https://192.168.1.1
UNIFI_NETWORK_API_KEY=
UNIFI_NETWORK_PREFIX=/proxy/network/integration/v1
UNIFI_INSECURE_TLS=1

# Legacy private Network Application fallback.
# Use only if the official API cannot perform the task.
UNIFI_LEGACY_BASE_URL=https://192.168.1.1
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
