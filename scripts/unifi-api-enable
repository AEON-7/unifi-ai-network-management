#!/usr/bin/env bash
set -euo pipefail
resolve_agent_home() {
  if [[ -n "${UNIFI_AGENT_HOME:-}" ]]; then printf '%s' "$UNIFI_AGENT_HOME"; return; fi
  if [[ -n "${OPENCLAW_DIR:-}" ]]; then printf '%s' "$OPENCLAW_DIR"; return; fi
  if [[ -n "${HERMES_HOME:-}" ]]; then printf '%s' "$HERMES_HOME"; return; fi
  if [[ -d "$HOME/.hermes/skills/unifi-api" && ! -d "$HOME/.openclaw/workspace/skills/unifi-api" ]]; then printf '%s' "$HOME/.hermes"; else printf '%s' "$HOME/.openclaw"; fi
}
AGENT_HOME="$(resolve_agent_home)"
ENV_FILE="${UNIFI_ENV_FILE:-$AGENT_HOME/unifi.env}"
DISABLED_FILE="${UNIFI_DISABLED_ENV_FILE:-$AGENT_HOME/unifi.env.disabled}"
STAMP="$(date +%Y%m%d-%H%M%S)"
restart_gateway() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files openclaw-gateway.service >/dev/null 2>&1; then
    systemctl --user restart openclaw-gateway.service
    echo "OpenClaw gateway restarted."
  else
    echo "Restart your agent/gateway manually if it caches env."
  fi
}
mkdir -p "$AGENT_HOME"
chmod 700 "$AGENT_HOME" 2>/dev/null || true
if [[ -f "$DISABLED_FILE" ]]; then
  if [[ -f "$ENV_FILE" ]]; then
    cp -p "$ENV_FILE" "${ENV_FILE}.bak-${STAMP}"
    chmod 600 "${ENV_FILE}.bak-${STAMP}"
    echo "Existing enabled file copied to ${ENV_FILE}.bak-${STAMP}"
  fi
  mv "$DISABLED_FILE" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  echo "UniFi API access reinstated locally: $DISABLED_FILE -> $ENV_FILE"
  restart_gateway
elif [[ -f "$ENV_FILE" ]]; then
  echo "UniFi API access already enabled: $ENV_FILE"
else
  echo "No disabled UniFi env file found. Create $ENV_FILE first."
  exit 1
fi
