#!/usr/bin/env bash
set -euo pipefail

OPENCLAW_DIR="${OPENCLAW_DIR:-$HOME/.openclaw}"
ENV_FILE="$OPENCLAW_DIR/unifi.env"
DISABLED_FILE="$OPENCLAW_DIR/unifi.env.disabled"
HELPER="$OPENCLAW_DIR/workspace/skills/unifi-api/scripts/unifi_api.py"
STAMP="$(date +%Y%m%d-%H%M%S)"

say() { printf '%s\n' "$*"; }

ask() {
  local prompt="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default]: " value
    printf '%s' "${value:-$default}"
  else
    read -r -p "$prompt: " value
    printf '%s' "$value"
  fi
}

ask_secret() {
  local prompt="$1" value confirm
  while true; do
    read -r -s -p "$prompt: " value
    printf '\n' >&2
    if [[ -z "$value" ]]; then
      printf '%s' ""
      return 0
    fi
    read -r -s -p "Confirm $prompt: " confirm
    printf '\n' >&2
    if [[ "$value" == "$confirm" ]]; then
      printf '%s' "$value"
      return 0
    fi
    say "Values did not match. Try again, or press Enter twice to skip." >&2
  done
}

ask_yes_no() {
  local prompt="$1" default="${2:-y}" answer suffix
  if [[ "$default" == "y" ]]; then suffix="Y/n"; else suffix="y/N"; fi
  read -r -p "$prompt [$suffix]: " answer
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy]$|^[Yy][Ee][Ss]$ ]]
}

write_line() {
  local key="$1" value="$2"
  if [[ -n "$value" ]]; then
    printf '%s=%s\n' "$key" "$value" >> "$TARGET_TMP"
  else
    printf '# %s=\n' "$key" >> "$TARGET_TMP"
  fi
}

restart_gateway() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files openclaw-gateway.service >/dev/null 2>&1; then
    systemctl --user restart openclaw-gateway.service
    say "OpenClaw gateway restarted."
  else
    say "OpenClaw gateway service not found; restart OpenClaw manually if it caches env."
  fi
}

say "UniFi API env configurator"
say "This writes $OPENCLAW_DIR/unifi.env. Secrets will not echo."
say ""

TARGET="$ENV_FILE"
if [[ ! -f "$ENV_FILE" && -f "$DISABLED_FILE" ]]; then
  say "Current state: UniFi API access is disabled via $DISABLED_FILE."
  if ask_yes_no "Update the disabled env file and keep access disabled" "y"; then
    TARGET="$DISABLED_FILE"
  else
    TARGET="$ENV_FILE"
  fi
fi

if [[ -f "$TARGET" ]]; then
  cp -p "$TARGET" "${TARGET}.bak-${STAMP}"
  chmod 600 "${TARGET}.bak-${STAMP}"
  say "Backup created: ${TARGET}.bak-${STAMP}"
fi

TARGET_TMP="$(mktemp)"
chmod 600 "$TARGET_TMP"
trap 'rm -f "$TARGET_TMP"' EXIT

cat > "$TARGET_TMP" <<HEADER
# UniFi API credentials for OpenClaw/Celina.
# Generated by unifi-setup on $(date -Is)
# Keep this file private. Disable quickly with: unifi-off

HEADER

say "Configure Site Manager cloud API?"
if ask_yes_no "Add Site Manager API key" "n"; then
  site_key="$(ask_secret 'UNIFI_SITE_MANAGER_API_KEY')"
  site_base="$(ask 'UNIFI_SITE_MANAGER_BASE_URL' 'https://api.ui.com/v1')"
else
  site_key=""
  site_base="https://api.ui.com/v1"
fi
write_line "UNIFI_SITE_MANAGER_API_KEY" "$site_key"
write_line "UNIFI_SITE_MANAGER_BASE_URL" "$site_base"
printf '\n' >> "$TARGET_TMP"

say ""
say "Configure official local UniFi Network API?"
if ask_yes_no "Add local Network API key" "y"; then
  network_base="$(ask 'UNIFI_NETWORK_BASE_URL, e.g. https://192.168.1.1')"
  network_key="$(ask_secret 'UNIFI_NETWORK_API_KEY')"
  network_prefix="$(ask 'UNIFI_NETWORK_PREFIX' '/proxy/network/integration/v1')"
  insecure="0"
  if ask_yes_no "Use insecure TLS for a self-signed local controller cert" "y"; then insecure="1"; fi
else
  network_base=""
  network_key=""
  network_prefix="/proxy/network/integration/v1"
  insecure=""
fi
write_line "UNIFI_NETWORK_BASE_URL" "$network_base"
write_line "UNIFI_NETWORK_API_KEY" "$network_key"
write_line "UNIFI_NETWORK_PREFIX" "$network_prefix"
write_line "UNIFI_INSECURE_TLS" "$insecure"
printf '\n' >> "$TARGET_TMP"

say ""
say "Configure legacy private API fallback? Only use this if API-key routes are insufficient."
if ask_yes_no "Add legacy username/password fallback" "n"; then
  legacy_base="$(ask 'UNIFI_LEGACY_BASE_URL' "${network_base:-https://192.168.1.1}")"
  legacy_user="$(ask 'UNIFI_USERNAME')"
  legacy_pass="$(ask_secret 'UNIFI_PASSWORD')"
  legacy_site="$(ask 'UNIFI_SITE' 'default')"
else
  legacy_base=""
  legacy_user=""
  legacy_pass=""
  legacy_site="default"
fi
write_line "UNIFI_LEGACY_BASE_URL" "$legacy_base"
write_line "UNIFI_USERNAME" "$legacy_user"
write_line "UNIFI_PASSWORD" "$legacy_pass"
write_line "UNIFI_SITE" "$legacy_site"

install -m 600 "$TARGET_TMP" "$TARGET"
say ""
say "Wrote $TARGET with 0600 permissions."

if [[ "$TARGET" == "$DISABLED_FILE" ]]; then
  say "Access remains disabled. Run unifi-on when you want to reinstate it."
else
  if ask_yes_no "Restart OpenClaw gateway now" "y"; then
    restart_gateway
  fi
fi

say ""
say "Redacted status:"
if [[ -x "$HELPER" || -f "$HELPER" ]]; then
  python3 "$HELPER" env
else
  say "Helper not found: $HELPER"
fi
