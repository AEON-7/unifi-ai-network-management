#!/usr/bin/env bash
set -euo pipefail
OPENCLAW_DIR="${OPENCLAW_DIR:-$HOME/.openclaw}"
ENV_FILE="$OPENCLAW_DIR/unifi.env"
DISABLED_FILE="$OPENCLAW_DIR/unifi.env.disabled"
STAMP="$(date +%Y%m%d-%H%M%S)"

restart_gateway() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files openclaw-gateway.service >/dev/null 2>&1; then
    systemctl --user restart openclaw-gateway.service
    echo "OpenClaw gateway restarted."
  else
    echo "OpenClaw gateway service not found; restart your agent/gateway manually if it caches env."
  fi
}

mkdir -p "$OPENCLAW_DIR"
chmod 700 "$OPENCLAW_DIR" 2>/dev/null || true

if [[ -f "$ENV_FILE" ]]; then
  if [[ -f "$DISABLED_FILE" ]]; then
    mv "$DISABLED_FILE" "${DISABLED_FILE}.bak-${STAMP}"
    chmod 600 "${DISABLED_FILE}.bak-${STAMP}"
    echo "Existing disabled file moved to ${DISABLED_FILE}.bak-${STAMP}"
  fi
  mv "$ENV_FILE" "$DISABLED_FILE"
  chmod 600 "$DISABLED_FILE"
  echo "UniFi API access disabled locally: $ENV_FILE -> $DISABLED_FILE"
  restart_gateway
elif [[ -f "$DISABLED_FILE" ]]; then
  echo "UniFi API access already disabled: $DISABLED_FILE"
else
  echo "No UniFi env file found. Nothing to disable."
fi
